<mjml>
    <mj-head>
        <mj-attributes>
            <mj-text font-family="Arial, Helvetica, sans-serif" font-size="14px" />
        </mj-attributes>
    </mj-head>

    <mj-body background-color="#f4f6f8" width="800px">

        <!-- Header -->
        <mj-section background-color="#1e293b" padding="16px">
            <mj-column>
                <mj-text color="#ffffff" font-size="18px" font-weight="bold">
                    Approval Notification
                </mj-text>
            </mj-column>
        </mj-section>

        <!-- Content Card -->
        <mj-section padding="0"> <mj-column background-color="#ffffff" padding="20px" border-radius="6px">

                <mj-text>
                    Dear {{to}},
                </mj-text>

                <mj-text color="#555">
                    <strong>Action Required:</strong> There are some items that do not have a Country of Origin set.
                </mj-text>

                <mj-text color="#555">
                    Please review and update the Country of Origin for the affected items by clicking the button below.
                </mj-text>

                <mj-text color="#555">
                    The attached file can also be used to upload the Country of Origin information directly to the
                    system.
                    When using the attached file, please specify the <strong>Country</strong> for the items you want to update. Only items with a Country specified will be saved to the system. Items without a Country specified will not be saved.
                </mj-text>

                <mj-text padding-top="10px">
                    Please log in to the system to update the information.
                </mj-text>

                <mj-button font-family="Helvetica" background-color="#f45e43" color="white"
                    href="https://amecweb.mitsubishielevatorasia.co.th/procurement/ItemMaster">
                    Item master
                </mj-button>

            </mj-column>
        </mj-section>

        <!-- Footer -->
        <mj-section background-color="#f1f5f9" padding="10px">
            <mj-column>
                <mj-text font-size="12px" color="#888" align="center">
                    This is an automated email. Please do not reply.
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-body>
</mjml>