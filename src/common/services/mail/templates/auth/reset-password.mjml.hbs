<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Tahoma, Arial, Helvetica, sans-serif" />
      <mj-text font-size="16px" line-height="24px" color="#1f2937" />
    </mj-attributes>
  </mj-head>


   <mj-body background-color="#f4f6f8" width="800px">
    <!-- Header -->
        <mj-section background-color="#2563eb" padding="16px">
            <mj-column>
                <mj-text color="#ffffff" font-size="18px" font-weight="bold">
                    Reset Password Notification
                </mj-text>
            </mj-column>
        </mj-section>


    {{!-- Thai Version --}}
    <mj-section padding="0 0 0">
      <mj-column background-color="#ffffff" border="1px solid #e5e7eb" border-radius="10px" padding="24px">
        <mj-text font-size="24px" font-weight="700" color="#111827" padding="12px 0 12px">
            รีเซ็ตรหัสผ่าน
        </mj-text>

        <mj-text padding="0 0 16px">
            สวัสดี {{recipientThaiName}},
        </mj-text>

        <mj-text padding="0 0 16px" color="#374151">
            เราได้รับคำขอให้รีเซ็ตรหัสผ่านของคุณสำหรับ {{companyName}} คลิกปุ่มด้านล่างเพื่อเลือกตั้งรหัสผ่านใหม่
        </mj-text>

        <mj-button href="{{resetLink}}" background-color="#2563eb" color="#ffffff" border-radius="6px" padding="0 0 16px">
          รีเซ็ตรหัสผ่านของฉัน
        </mj-button>

        <mj-text padding="0 0 8px" color="#374151">
            หรือคัดลอกและวางลิงก์นี้ลงในเบราว์เซอร์ของคุณ:
        </mj-text>

        <mj-text padding="0 0 16px">
          <a href="{{resetLink}}" style="color:#2563eb; word-break:break-all;">{{resetLink}}</a>
        </mj-text>

        <mj-text padding="0 0 8px" color="#6b7280" font-size="13px">
            ลิงก์นี้จะหมดอายุในวันที่ {{expiresAt}}.
        </mj-text>

        <mj-text color="#6b7280" font-size="13px" padding="0">
            หากคุณไม่ได้ร้องขอการเปลี่ยนแปลงนี้ คุณสามารถละเว้นอีเมลนี้ได้อย่างปลอดภัย
        </mj-text>
      </mj-column>
    </mj-section>

    {{!-- English Version --}}
    <mj-section padding="24px 0 0">
      <mj-column background-color="#ffffff" border="1px solid #e5e7eb" border-radius="10px" padding="24px">
        <mj-text font-size="24px" font-weight="700" color="#111827" padding="12px 0 12px">
          Reset Password
        </mj-text>

        <mj-text padding="0 0 16px">
          Hi {{recipientName}},
        </mj-text>

        <mj-text padding="0 0 16px" color="#374151">
          We received a request to reset your password for {{companyName}}. Click the button below to choose a new password.
        </mj-text>

        <mj-button href="{{resetLink}}" background-color="#2563eb" color="#ffffff" border-radius="6px" padding="0 0 16px">
          Reset My Password
        </mj-button>

        <mj-text padding="0 0 8px" color="#374151">
          Or copy and paste this link into your browser:
        </mj-text>

        <mj-text padding="0 0 16px">
          <a href="{{resetLink}}" style="color:#2563eb; word-break:break-all;">{{resetLink}}</a>
        </mj-text>

        <mj-text padding="0 0 8px" color="#6b7280" font-size="13px">
          This link will expire at {{expiresAt}}.
        </mj-text>

        <mj-text color="#6b7280" font-size="13px" padding="0">
          If you did not request this change, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
